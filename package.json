{
  "name": "unidoar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "db:seed": "dotenv -e .env.local -- tsx src/db/seed.ts",
    "db:rls": "dotenv -e .env.local -- tsx src/db/rls.ts",
    "db:sedes": "dotenv -e .env.local -- tsx src/db/sedes-base.ts",
    "db:planes": "dotenv -e .env.local -- tsx src/db/planes-base.ts",
    "db:entrevista": "dotenv -e .env.local -- tsx src/db/entrevista-base.ts",
    "db:storage": "dotenv -e .env.local -- tsx src/db/storage.ts",
    "db:setup": "pnpm db:push && pnpm db:rls && pnpm db:storage && pnpm db:seed",
    "db:vincular": "dotenv -e .env.local -- tsx src/db/vincular-cuentas.ts",
    "db:admin": "dotenv -e .env.local -- tsx src/db/hacer-admin.ts",
    "db:limpiar-archivos": "dotenv -e .env.local -- tsx src/db/limpiar-archivos.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "leaflet": "^1.9.4",
    "next": "16.3.8",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.0"
}
