# Copiar a .env.local. Lo más simple: `vercel env pull .env.local --yes` (trae todo esto ya cargado).
# Supabase se instala desde el Marketplace de Vercel (vercel integration add supabase) y aprovisiona estas variables solo.

# Supabase — Auth y Storage
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública (anon / publishable): viaja al navegador, por eso las tablas llevan RLS activado.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio: SOLO servidor. Saltea RLS. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase — Postgres (con Drizzle)
# Conexión que usa la APP: pooler de SESIÓN (puerto 5432, host ...pooler.supabase.com, IPv4).
# No usar el pooler de transacciones (6543) para la app: con este driver se traba al reutilizar conexiones.
DATABASE_URL=
# Lo usan db:push, db:seed y las migraciones (mismo pooler de sesión).
POSTGRES_URL_NON_POOLING=
# Pooler de transacciones (6543). La app no lo usa; solo queda como respaldo si falta DATABASE_URL.
POSTGRES_URL=

# Opcional: conexiones a la base por instancia (por defecto 2 en Vercel y 5 en local).
# Subirlo solo si se agranda el "Pool Size" de Supabase (Database → Connection pooling).
# DB_POOL_MAX=2

# Mails de la app (Resend). Sin RESEND_API_KEY el envío está apagado: no se manda ni se anota nada. Guía: docs/correo.md
# RESEND_API_KEY=
# CORREO_MODO=consola        # solo imprime en el log (para probar); "apagado" lo desactiva
# CORREO_DE="UNIDOAR <no-responder@unidoar.com.ar>"
# CORREO_RESPONDER_A=hola@unidoar.com.ar
# CORREO_DE_FACTURACION="UNIDOAR Facturación <facturacion@unidoar.com.ar>"
# CORREO_RESPONDER_A_FACTURACION=facturacion@unidoar.com.ar
# CORREO_EQUIPO=equipo@unidoar.com.ar   # avisos internos; sin esto, los emails de las cuentas admin

# NEXT_PUBLIC_SITE_URL=https://unidoar.com.ar   # origen de los enlaces de los mails

# Ocultar los datos de ejemplo (instituciones y profesionales sembrados con db:seed, y los testimonios de ejemplo) de todo lo que ve la gente:
# sitio público, catálogo, buscadores, recomendaciones y el tablero "Operación". No borra nada. Se prende el día de abrir al público
# (OCULTAR_DATOS_DE_EJEMPLO=1 en Vercel) y hay que volver a desplegar. Con la variable vacía los ejemplos se ven, como hoy.
# OCULTAR_DATOS_DE_EJEMPLO=
